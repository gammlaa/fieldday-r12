---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Impressum der Webseite zum R12 Fieldday.",
	title: "Impressum",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">Impressum</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			Diese Seite ist als Platzhalter vorbereitet. Die rechtlich verantwortlichen Angaben muessen
			vor der Veroeffentlichung ergaenzt und geprueft werden.
		</p>
		<h2>Angaben gemaess § 5 TMG</h2>
		<p>
			DARC Ortsverband R12<br />
			[Name der verantwortlichen Person]<br />
			[Anschrift]<br />
			[Kontakt]
		</p>
		<h2>Redaktionell verantwortlich</h2>
		<p>[Name und Anschrift der verantwortlichen Person]</p>
	</div>
</PageLayout>
